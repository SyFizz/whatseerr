# Copy this file to `.env` and fill in the values. `.env` is git-ignored: NEVER commit it.

# Required. Shared secret between Seerr and whatseerr (min. 16 chars).
# Generate one with: openssl rand -hex 32
# In Seerr > Settings > Notifications > Webhook, set "Authorization Header" to: Bearer <WEBHOOK_SECRET>
WEBHOOK_SECRET=

# JID of the target WhatsApp group (looks like 120363012345678901@g.us).
# Leave empty on first start, pair the account, then list groups to find it.
WHATSAPP_GROUP_JID=

# Optional. Phone number (digits only, with country code, e.g. 33612345678) to pair
# with an 8-character pairing code instead of scanning the QR code shown in the logs.
WHATSAPP_PAIRING_PHONE=

# Message language: fr (default) or en.
LANGUAGE=fr

# Optional overrides.
# PORT=8080
# LOG_LEVEL=info
# WHATSAPP_LOG_LEVEL=warn   # Baileys library logs; debug/trace may expose session details

# Log messages instead of sending them (to test the Seerr integration without WhatsApp).
# DRY_RUN=false
